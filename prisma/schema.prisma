generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  walletAddress    String    @unique
  telegramChatId   String?   @unique
  telegramUsername String?
  linkCode         String?
  linkCodeExpiry   DateTime?
  createdAt        DateTime  @default(now())

  agents      Agent[]
  lpPositions LPPosition[]
  positions   Position[]
}

model Agent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name                String
  smartAccountAddress String? @unique

  status   String @default("PENDING_FUNDING") // PENDING_FUNDING, ACTIVE, PAUSED_TIER, STOPPED
  strategy String
  mode     String @default("SEMI") // MANUAL, SEMI
  capital  Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  erc8004Id          String?
  identityTxHash     String?

  lpPositions    LPPosition[]
  positions      Position[]
  pendingActions PendingAction[]
}

model PendingAction {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  type      String // "OPEN_POSITION", "CLOSE_POSITION"
  payload   Json
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED
  createdAt DateTime @default(now())
}

model Position {
  id           String   @id @default(uuid())
  tokenAddress String
  type         String
  status       String
  entryPrice   Float
  size         Float
  exitPrice    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tokenId      String?
  copiedFrom   String?
  source       String   @default("SCOUT")
  pnl          Float?
  tokenName    String?
  tokenSymbol  String?
  txHash       String?
  exitTxHash   String?
  tradingMode  String   @default("LIVE")
  exitReason   String?

  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])
}

model Signal {
  id           String   @id @default(uuid())
  tokenAddress String
  score        Float
  passed       Boolean
  rawContext   Json
  createdAt    DateTime @default(now())
  copiedFrom   String?
  source       String   @default("SCOUT")
}

model Log {
  id        String   @id @default(uuid())
  level     String
  message   String
  meta      Json?
  createdAt DateTime @default(now())
}

model TrackedWallet {
  id                String    @id @default(uuid())
  address           String    @unique
  label             String?
  tier              Int       @default(2)
  bundleId          String?
  status            String    @default("ACTIVE")
  entrySource       String?
  totalSignals      Int       @default(0)
  copiedSignals     Int       @default(0)
  winRate           Float?
  avgPnlR           Float?
  lastTradeAt       DateTime?
  createdAt         DateTime  @default(now())
  consecutiveLosses Int       @default(0)
}

model SystemConfig {
  key   String @id
  value String
}

model WalletPosition {
  id             String   @id @default(uuid())
  walletAddress  String
  tokenAddress   String
  status         String   @default("OPEN")
  totalWethSpent Float
  totalTokens    Float
  avgEntryPrice  Float
  realizedPnl    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DexProtocol {
  id              String   @id @default(uuid())
  name            String
  version         String
  routerAddress   String?
  factoryAddress  String?
  quoterAddress   String?
  positionManager String?
  poolManager     String?
  stateView       String?
  verified        Boolean  @default(false)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

/// Tracks Uniswap V3 LP positions managed by LP Engine
model LPPosition {
  id                 String   @id @default(uuid())
  tokenId            String   @unique
  txHash             String?
  exitTxHash         String?
  pool               String
  token0             String
  token1             String
  token0Symbol       String?
  token1Symbol       String?
  feeTier            Int
  tickLower          Int
  tickUpper          Int
  entryValue         Float
  entryTick          Int      @default(0)
  simulatedLiquidity String? // For DRY_RUN simulated positions
  feesCollected      Float    @default(0)
  harvestedFees      Float    @default(0)
  ilRunning          Float    @default(0)
  feeAboveILHours    Int      @default(0)
  ilAboveFeeHours    Int      @default(0)
  lastFeeGrowth0     String?
  lastFeeGrowth1     String?
  /// Tracks consecutive minutes position has been out of range (for grace period)
  outOfRangeMinutes  Int      @default(0)
  mode               String   @default("MANUAL")
  status             String   @default("PENDING")
  dayMode            Boolean  @default(false)
  nightMode          Boolean  @default(false)
  sessionKeyId       String?
  tradingMode        String   @default("DRY_RUN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  source             String   @default("SYSTEM")
  managerAddress     String?
  sentimentStatus    String?

  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])
}

model SessionKey {
  id          String   @id @default(uuid())
  userId      String
  keyAddress  String   @unique
  privateKey  String?
  scope       Json
  expiry      DateTime
  status      String   @default("ACTIVE")
  sdkProvider String   @default("alchemy")
  createdAt   DateTime @default(now())
}

model Watchlist {
  id              String    @id @default(uuid())
  tokenAddress    String    @unique
  symbol          String?
  name            String?
  quoteSymbol     String? // WETH, USDG, etc.
  quoteAddress    String? // The actual 0x address of the quote token
  poolAddress     String?
  addedAt         DateTime  @default(now())
  lastCheckedAt   DateTime?
  tradingMode     String    @default("LIVE")
  status          String    @default("WATCHING") // WATCHING, EXECUTED, DROPPED
  athClose        Float?
  timeframe       Int       @default(15)
  sentimentStatus String?
}

model TokenBlacklist {
  id             String   @id @default(uuid())
  tokenAddress   String   @unique
  athPriceAtExit Float?
  reason         String?
  blacklistedAt  DateTime @default(now())
}

model FactoryRegistry {
  id                       String    @id @default(uuid())
  name                     String // "hood.fun", "NOXA", etc.
  address                  String    @unique
  status                   String    @default("active") // "active" | "dead" | "dormant"
  deploys7d                Int       @default(0)
  consecutiveLivenessFails Int       @default(0)
  lastDeployAt             DateTime?
  updatedAt                DateTime  @updatedAt
  createdAt                DateTime  @default(now())
}

model LivenessCache {
  tokenAddress String   @id
  verdict      String // "ALIVE" | "DEAD"
  failedCheck  String? // "L1" | "L2" | etc.
  failReason   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
